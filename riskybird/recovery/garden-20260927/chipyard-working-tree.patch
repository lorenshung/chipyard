+      case (pin, io) => {
+        kth.xdc.addPackagePin(io, pin)
+        kth.xdc.addIOStandard(io, ioStandard)
+      }
+    }
+    if (misoPulldown) kth.xdc.addPulldown(IOPin(miso))
+  }
