+    sck  := port.io.sck
+    mosi := port.io.dq(0).o
+    port.io.dq(0).i := false.B          // MOSI is output-only here
+    port.io.dq(1).i := miso
+    port.io.dq(2).i := false.B
+    port.io.dq(3).i := false.B
