+#################################
+# NVFP4 RoCC accelerator (custom0)
+#################################
+
+# nvfp4.h reuses cores/gemmini/rocc-software/src/xcustom.h from the
+# modelblaster checkout rather than vendoring a second copy of the RoCC
+# .insn macros. Override with -D MODELBLASTER_ROOT=... if it lives elsewhere.
+set(MODELBLASTER_ROOT "/scratch2/loren/modelblaster" CACHE PATH
+    "modelblaster checkout supplying rocc-software/src/xcustom.h")
+
+add_executable(nvfp4_gemm nvfp4_gemm.c)
+target_include_directories(nvfp4_gemm PRIVATE "${MODELBLASTER_ROOT}/cores/gemmini")
+# The MODELBLASTER_VERIFY marker line prints %.9g; newlib-nano only links its
+# float printf when _printf_float is forced. Scoped to this target only.
+set_target_properties(nvfp4_gemm PROPERTIES LINK_FLAGS "-u _printf_float")
+add_dump_target(nvfp4_gemm)
+
+add_executable(nvfp4_layer nvfp4_layer.c)
+target_include_directories(nvfp4_layer PRIVATE "${MODELBLASTER_ROOT}/cores/gemmini")
+# Same %.9g marker line as nvfp4_gemm; newlib-nano needs _printf_float forced.
+set_target_properties(nvfp4_layer PROPERTIES LINK_FLAGS "-u _printf_float")
+add_dump_target(nvfp4_layer)
