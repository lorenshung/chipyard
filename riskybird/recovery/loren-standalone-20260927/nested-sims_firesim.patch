diff --git a/platforms/xilinx_alveo_u250/build-bitstream.sh b/platforms/xilinx_alveo_u250/build-bitstream.sh
index 46ec8f1b6..6fafd5740 100755
--- a/platforms/xilinx_alveo_u250/build-bitstream.sh
+++ b/platforms/xilinx_alveo_u250/build-bitstream.sh
@@ -70,6 +70,17 @@ if [ -z "$BOARD" ] ; then
     usage 1
 fi
 
+# FireSim runs this via Fabric over SSH using a non-interactive shell, which does not source ~/.bashrc.
+
+if [ "$(uname -n)" = garden ]; then
+  [ -f /ecad/tools/vlsi.bashrc ] && . /ecad/tools/vlsi.bashrc
+  [ -f /ecad/tools/xilinx/Vitis/2023.1/settings64.sh ] && . /ecad/tools/xilinx/Vitis/2023.1/settings64.sh
+fi
+if ! command -v vivado >/dev/null 2>&1; then
+    echo "vivado not found on PATH" >&2
+    exit 127
+fi
+
 # run build
 cd $CL_DIR
 vivado -mode batch -source $CL_DIR/scripts/main.tcl -tclargs $FREQUENCY $STRATEGY $BOARD
